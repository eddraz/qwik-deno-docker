{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-scripts.ts &&qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/deno/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "build.scripts": "tsx scripts/build-scripts.ts",
    "watch.scripts": "tsc -p tsconfig.scripts.json --watch",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "concurrently \"vite --mode ssr\" \"tsc -p tsconfig.scripts.json --watch\"",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "serve": "deno run --env-file=.env --allow-net --allow-read --allow-env server/entry.deno.js",
    "start": "vite --open --mode ssr",
    "prepare.env.file": "base64 .env > .env.base64 && gh secret set ENV_FILE_CONTENT --repo eddraz/qwik-deno-docker --body '$(cat .env.base64)'",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.12.1",
    "@builder.io/qwik-city": "^1.12.1",
    "@types/eslint": "8.56.10",
    "@types/node": "20.14.11",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "concurrently": "^9.1.2",
    "eslint": "8.57.0",
    "eslint-plugin-qwik": "^1.12.1",
    "firebase": "^11.4.0",
    "prettier": "3.3.3",
    "tsx": "^4.7.1",
    "typescript": "5.4.5",
    "undici": "*",
    "vite": "5.3.5",
    "vite-tsconfig-paths": "^4.2.1"
  }
}
